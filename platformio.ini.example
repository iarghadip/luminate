; PlatformIO Project Configuration File
;
;   Build options: build flags, source filter
;   Upload options: custom upload port, speed and extra flags
;   Library options: dependencies, extra library storages
;   Advanced options: extra scripting
;
; Please visit documentation for the other options and examples
; https://docs.platformio.org/page/projectconf.html

[env:esp32dev]
platform = espressif32
board = esp32dev
framework = arduino
monitor_speed = 115200
board_build.filesystem = spiffs
upload_protocol = esptool

lib_deps =

    bblanchon/ArduinoJson@^7.4.1

build_flags =

    -DFIRMWARE_NAME="\"Luminate\""
    -DFIRMWARE_VERSION="\"1.1.0\""

    -DKEY_WIFI_SSID="\"wifi.ssid\""
    -DKEY_WIFI_PASSWORD="\"wifi.password\""

    -DDEBUG_FREQUENCY=115200
    -DDEBUG_MODE_ENABLED=0

    -DHTTP_REQUEST_INTERVAL=30000
    -DHTTP_REQUEST_TIMEOUT=60000

    -DBRIGHTNESS_MINIMUM_PERCENT=5.0f
    -DBRIGHTNESS_RENDER_INTERVAL=25
    -DBRIGHTNESS_UPDATE_INTERVAL=1000
    
    -DTIME_UPDATE_INTERVAL=3600000
    -DMAIN_LOOP_INTERVAL=25
    -DWIFI_LED_BLINK_INTERVAL=150
    -DDEVICE_RESTART_TIMEOUT=2500
    -DRESET_BUTTON_PRESS_TIMEOUT=5000

    -DPIN_RESET_BUTTON=0
    -DPIN_LED_WIFI=2
    -DPIN_LED_COOL=16
    -DPIN_LED_WARM=17
    -DPIN_BLDC_FAN=18
    -DPIN_I2C_SDA=21
    -DPIN_I2C_SCL=22

    -DPWM_FREQUENCY=5000
    -DPWM_RESOLUTION_BITS=8
    -DPWM_CHANNEL_LED_COOL=0
    -DPWM_CHANNEL_LED_WARM=1
    -DPWM_CHANNEL_BLDC_FAN=2

    -DI2C_FREQUENCY=400000

    -DAPI_TIME_URL="\"\""